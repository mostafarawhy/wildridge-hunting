generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id        String    @id @default(cuid())
  nameEn    String
  nameAr    String?
  nameRu    String?
  slug      String    @unique
  isVisible Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isVisible])
  @@index([deletedAt])
}

model Category {
  id            String     @id @default(cuid())
  nameAr        String
  nameEn        String
  nameRu        String?
  slug          String
  parentId      String?
  displayOrder  Int        @default(0)
  imageFilename String?
  storageKey    String?
  isVisible     Boolean    @default(true)
  navGroup      NavGroup?
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryTree")
  products      Product[]
  productLinks  ProductCategory[]

  @@index([parentId])
  @@index([slug])
  @@index([nameEn])
  @@index([isVisible])
  @@index([displayOrder])
  @@index([deletedAt])
  @@index([navGroup])
}

model Product {
  id                     String                   @id @default(cuid())
  sku                    String                   @unique
  nameAr                 String
  nameEn                 String
  nameRu                 String?
  slugEn                 String                   @unique
  legacyBrand            String?                  @map("brand")
  brandId                String?
  actionType             ActionType
  caliberMm              Decimal?                 @db.Decimal(5, 2)
  descriptionAr          String?
  descriptionEn          String?
  descriptionRu          String?
  categoryId             String
  tags                   String[]                 @default([])
  price                  Decimal                  @db.Decimal(10, 2)
  compareAtPrice         Decimal?                 @db.Decimal(10, 2)
  stockQuantity          Int                      @default(0)
  reservedQuantity       Int                      @default(0)
  lowStockThreshold      Int                      @default(5)
  weightGrams            Int?
  requiresIdVerification Boolean                  @default(false)
  serialTracking         SerialTracking           @default(NONE)
  supportsAddons         Boolean                  @default(false)
  b2bAvailable           Boolean                  @default(false)
  minOrderQty            Int                      @default(1)
  maxOrderQty            Int?
  isNewArrival           Boolean                  @default(false)
  isFeatured             Boolean                  @default(false)
  sortOrder              Int?
  loyaltyPointsEarn      Int                      @default(0)
  loyaltyRule            LoyaltyEarnRule          @default(STANDARD)
  loyaltyMultiplier      Decimal?                 @db.Decimal(4, 1)
  loyaltyRuleStartsAt    DateTime?
  loyaltyRuleEndsAt      DateTime?
  publishStatus          PublishStatus            @default(DRAFT)
  metaTitleAr            String?                  @db.VarChar(60)
  metaTitleEn            String?                  @db.VarChar(60)
  metaTitleRu            String?                  @db.VarChar(60)
  metaDescriptionAr      String?                  @db.VarChar(160)
  metaDescriptionEn      String?                  @db.VarChar(160)
  metaDescriptionRu      String?                  @db.VarChar(160)
  internalNotes          String?
  deletedAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  addonLinks             AddonProductLink[]
  accessoryLinks         ProductAccessory[]       @relation("ProductAccessories")
  accessoryOf            ProductAccessory[]       @relation("AccessoryOf")
  categoryLinks          ProductCategory[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  brandRef               Brand?                   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category               Category                 @relation(fields: [categoryId], references: [id])
  images                 ProductImage[]
  reviews                ProductReview[]
  specs                  ProductSpec[]
  quoteItems             QuoteItem[]
  stockMovements         StockMovement[]
  wishlistItems          WishlistItem[]
  featuredInCollections  FeaturedCollectionItem[]

  @@index([b2bAvailable])
  @@index([categoryId, publishStatus, sortOrder])
  @@index([requiresIdVerification])
  @@index([publishStatus])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([legacyBrand])
  @@index([brandId])
  @@index([actionType])
  @@index([caliberMm])
  @@index([price])
  @@index([stockQuantity])
  @@index([sortOrder])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([tags], map: "idx_product_tags", type: Gin)
}

model ProductImage {
  id           String   @id @default(cuid())
  productSku   String
  filename     String
  storageKey   String?
  altTextAr    String?
  altTextEn    String?
  altTextRu    String?
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productSku], references: [sku], onDelete: Cascade)

  @@unique([productSku, displayOrder])
  @@index([productSku])
}

model ProductSpec {
  id           String   @id @default(cuid())
  productSku   String
  labelAr      String
  labelEn      String
  labelRu      String?
  valueAr      String
  valueEn      String
  valueRu      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productSku], references: [sku], onDelete: Cascade)

  @@unique([productSku, labelEn])
  @@index([productSku])
  @@index([displayOrder])
}

model Addon {
  id                String               @id @default(cuid())
  addonId           String               @unique
  nameAr            String
  nameEn            String
  nameRu            String?
  descriptionAr     String?
  descriptionEn     String?
  descriptionRu     String?
  price             Decimal              @db.Decimal(10, 2)
  compareAtPrice    Decimal?             @db.Decimal(10, 2)
  stockQuantity     Int                  @default(0)
  reservedQuantity  Int                  @default(0)
  lowStockThreshold Int                  @default(5)
  imageFilename     String?
  storageKey        String?
  isActive          Boolean              @default(true)
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  productLinks      AddonProductLink[]
  stockMovements    AddonStockMovement[]
  cartAddons        CartSelectedAddon[]
  orderItems        OrderItem[]
  quoteAddons       QuoteSelectedAddon[]

  @@index([isActive])
  @@index([stockQuantity])
  @@index([deletedAt])
}

model AddonProductLink {
  id           String   @id @default(cuid())
  addonId      String
  productSku   String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  addon        Addon    @relation(fields: [addonId], references: [addonId], onDelete: Cascade)
  product      Product  @relation(fields: [productSku], references: [sku], onDelete: Cascade)

  @@unique([addonId, productSku])
  @@index([productSku])
  @@index([addonId])
}

model ProductAccessory {
  id           String   @id @default(cuid())
  productSku   String
  accessorySku String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation("ProductAccessories", fields: [productSku], references: [sku], onDelete: Cascade)
  accessory    Product  @relation("AccessoryOf", fields: [accessorySku], references: [sku], onDelete: Cascade)

  @@unique([productSku, accessorySku])
  @@index([accessorySku])
}

model ProductCategory {
  id         String   @id @default(cuid())
  productSku String
  categoryId String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productSku], references: [sku], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productSku, categoryId])
  @@index([categoryId])
}

model Banner {
  id            String    @id @default(cuid())
  bannerId      String    @unique
  pageKey       String
  titleAr       String
  titleEn       String
  titleRu       String?
  subtitleAr    String?
  subtitleEn    String?
  subtitleRu    String?
  ctaAr         String?
  ctaEn         String?
  ctaRu         String?
  linkUrl       String?
  imageFilename String?
  storageKey    String?
  isActive      Boolean   @default(true)
  displayOrder  Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([pageKey, isActive])
  @@index([displayOrder])
}

model Page {
  id                String   @id @default(cuid())
  key               String   @unique
  slug              String   @unique
  titleAr           String
  titleEn           String
  titleRu           String?
  contentAr         String?
  contentEn         String?
  contentRu         String?
  metaTitleAr       String?  @db.VarChar(60)
  metaTitleEn       String?  @db.VarChar(60)
  metaTitleRu       String?  @db.VarChar(60)
  metaDescriptionAr String?  @db.VarChar(160)
  metaDescriptionEn String?  @db.VarChar(160)
  metaDescriptionRu String?  @db.VarChar(160)
  isActive          Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@index([slug])
  @@index([isActive])
}

model Store {
  id            String   @id @default(cuid())
  nameEn        String
  nameAr        String?
  nameRu        String?
  addressEn     String
  addressAr     String?
  addressRu     String?
  descriptionEn String?
  descriptionAr String?
  descriptionRu String?
  hoursNoteEn   String?
  hoursNoteAr   String?
  hoursNoteRu   String?
  latitude      Float
  longitude     Float
  phone         String?
  email         String?
  openingHours  Json?
  isActive      Boolean  @default(true)
  isPrimary     Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@unique([isPrimary], map: "Store_single_primary_key", where: raw("\"isPrimary\""))
}

model ProjectConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id                    String               @id @default(cuid())
  supabaseUserId        String?              @unique
  email                 String               @unique
  name                  String
  role                  StaffRole
  passwordHash          String?
  mustChangePassword    Boolean              @default(false)
  isActive              Boolean              @default(true)
  lastLoginAt           DateTime?
  previousLoginAt       DateTime?
  tokenVersion          Int                  @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  addonStockMovements   AddonStockMovement[]
  reviewedB2B           B2BAccount[]         @relation("B2BReviewedBy")
  importBatches         ImportBatch[]
  orderEvents           OrderEvent[]
  quoteEvents           QuoteEvent[]
  quotedQuotes          QuoteRequest[]       @relation("QuoteQuotedBy")
  stockMovements        StockMovement[]
  reviewedVerifications VerificationEvent[]  @relation("VerificationReviewedBy")
  ticketsCreated        Ticket[]             @relation("TicketCreatedBy")
  ticketsAssigned       Ticket[]             @relation("TicketAssignedTo")
  ticketEvents          TicketEvent[]
  documentRequests      DocumentRequest[]    @relation("DocumentRequestedBy")
  verificationDocumentRequests VerificationDocumentRequest[] @relation("VerificationDocumentRequestedBy")
  orderPayments         OrderPayment[]
  orderRefunds          OrderRefund[]
  orderItemSerials      OrderItemSerial[]

  @@index([role])
  @@index([isActive])
}

model Customer {
  id                    String               @id @default(cuid())
  supabaseUserId        String?              @unique
  email                 String               @unique
  name                  String
  phone                 String?
  passwordHash          String?
  role                  CustomerRole         @default(B2C)
  isActive              Boolean              @default(true)
  lastLoginAt           DateTime?
  emailVerifiedAt       DateTime?
  verificationStatus    VerificationStatus   @default(NOT_REQUIRED)
  verifiedAt            DateTime?
  verificationExpiresAt DateTime?
  uaePassUuid           String?              @unique
  loyaltyPoints         Int                  @default(0)
  tokenVersion          Int                  @default(0)
  locale                String               @default("en")
  internalNotes         String?
  deletedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  b2bAccount            B2BAccount[]
  carts                 Cart[]
  couponRedemptions     CouponRedemption[]
  addresses             CustomerAddress[]
  klaviyoEvents         KlaviyoEvent[]
  loyaltyTransactions   LoyaltyTransaction[]
  orders                Order[]
  personalCoupons       Coupon[]
  reviews               ProductReview[]
  quoteRequests         QuoteRequest[]
  verificationEvents    VerificationEvent[]
  wishlistItems         WishlistItem[]
  tickets               Ticket[]
  createdTickets        Ticket[]             @relation("TicketCreatedByCustomer")
  uaePassTickets        UaePassSignInTicket[]
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([role])
  @@index([verificationStatus])
  @@index([isActive])
  @@index([createdAt])
  @@index([deletedAt])
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  label        String?
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  emirate      String
  country      String   @default("AE")
  postalCode   String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([emirate])
}

model UaePassSignInTicket {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  customerId String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  customerId String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  customerId String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model UaePassPendingLink {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  uaePassUuid  String
  email        String?
  fullnameEN   String?
  firstnameEN  String?
  lastnameEN   String?
  nationalityEN String?
  userType     String
  idnPresent   Boolean   @default(false)
  locale       String
  callbackUrl  String
  attemptCount Int       @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([expiresAt])
  @@index([uaePassUuid])
}

model B2BAccount {
  id               String            @id @default(cuid())
  customerId       String
  companyNameEn    String
  companyNameAr    String?
  contactName      String?
  contactPhone     String?
  tradeLicenseNo   String
  vatNumber        String?
  status           B2BStatus         @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  verifiedAt       DateTime?
  expiresAt        DateTime?
  rejectionReason  String?
  creditLimitAed   Decimal?          @db.Decimal(10, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reviewedBy       Staff?            @relation("B2BReviewedBy", fields: [reviewedById], references: [id])
  documents        B2BDocument[]
  quoteRequests    QuoteRequest[]
  documentRequests DocumentRequest[]
  tickets          Ticket[]

  @@unique([customerId], map: "unique_active_b2b_per_customer", where: raw("(\"status\" IN ('PENDING', 'APPROVED', 'SUSPENDED'))"))
  @@unique([tradeLicenseNo], map: "unique_active_b2b_per_trade_license", where: raw("(\"status\" IN ('PENDING', 'APPROVED', 'SUSPENDED'))"))
  @@index([customerId])
  @@index([status])
  @@index([reviewedById])
}

model B2BDocument {
  id             String           @id @default(cuid())
  b2bAccountId   String
  type           DocumentType
  filename       String
  storageKey     String
  mimeType       String?
  uploadedAt     DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  supersededAt   DateTime?
  declaredNumber String?
  label          String?
  requestId      String?
  b2bAccount     B2BAccount       @relation(fields: [b2bAccountId], references: [id], onDelete: Cascade)
  request        DocumentRequest? @relation(fields: [requestId], references: [id])

  @@index([b2bAccountId])
  @@index([type])
  @@index([b2bAccountId, supersededAt])
  @@index([requestId])
}

model DocumentRequest {
  id            String                @id @default(cuid())
  b2bAccountId  String
  scope         DocumentRequestScope  @default(DOCUMENTS)
  status        DocumentRequestStatus @default(OPEN)
  types         DocumentType[]        @default([])
  message       String
  requestedById String
  fulfilledAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  b2bAccount    B2BAccount            @relation(fields: [b2bAccountId], references: [id], onDelete: Cascade)
  requestedBy   Staff                 @relation("DocumentRequestedBy", fields: [requestedById], references: [id])
  documents     B2BDocument[]

  @@unique([b2bAccountId], map: "unique_open_document_request_per_account", where: raw("(\"status\" = 'OPEN')"))
  @@index([b2bAccountId])
  @@index([status])
  @@index([requestedById])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String?
  guestToken String?    @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@index([customerId])
  @@index([guestToken])
  @@index([updatedAt])
}

model CartItem {
  id             String              @id @default(cuid())
  cartId         String
  productSku     String
  quantity       Int
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  cart           Cart                @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productSku], references: [sku])
  selectedAddons CartSelectedAddon[]

  @@unique([cartId, productSku])
  @@index([cartId])
  @@index([productSku])
}

model CartSelectedAddon {
  id         String   @id @default(cuid())
  cartItemId String
  addonId    String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  addon      Addon    @relation(fields: [addonId], references: [addonId])
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  @@unique([cartItemId, addonId])
  @@index([cartItemId])
  @@index([addonId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productSku String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productSku], references: [sku])

  @@unique([customerId, productSku])
  @@index([customerId])
  @@index([productSku])
}

model ProductReview {
  id                 String       @id @default(cuid())
  productSku         String
  customerId         String?
  rating             Int
  title              String?
  body               String?
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  customer           Customer?    @relation(fields: [customerId], references: [id])
  product            Product      @relation(fields: [productSku], references: [sku])

  @@unique([productSku, customerId], map: "unique_review_per_customer_per_product", where: raw("(\"customerId\" IS NOT NULL)"))
  @@index([productSku, customerId])
  @@index([productSku])
  @@index([customerId])
  @@index([status])
  @@index([rating])
}

model Order {
  id                      String               @id @default(cuid())
  orderNumber             String               @unique
  customerId              String
  status                  OrderStatus          @default(PENDING)
  subtotal                Decimal              @db.Decimal(10, 2)
  addonTotal              Decimal              @default(0) @db.Decimal(10, 2)
  shippingCost            Decimal              @default(0) @db.Decimal(10, 2)
  discountAmount          Decimal              @default(0) @db.Decimal(10, 2)
  taxAmount               Decimal              @default(0) @db.Decimal(10, 2)
  total                   Decimal              @db.Decimal(10, 2)
  loyaltyPointsEarned     Int                  @default(0)
  loyaltyPointsUsed       Int                  @default(0)
  loyaltyDiscountAmount   Decimal              @default(0) @db.Decimal(10, 2)
  loyaltyPointsFrozenAt   DateTime?
  refundDue               Decimal              @default(0) @db.Decimal(10, 2)
  couponCode              String?
  paymentProvider         PaymentProvider      @default(NGENIUS)
  nGeniusOrderRef         String?
  nGeniusPayRef           String?
  paidAt                  DateTime?
  shippingAddressSnapshot Json
  billingAddressSnapshot  Json?
  complianceSnapshot      Json?
  trackingNumber          String?
  trackingUrl             String?
  shippedAt               DateTime?
  shippingQuotedAt        DateTime?
  shippingQuotedBy        String?
  deliveredAt             DateTime?
  carrier                 String?
  parcelCount             Int?
  shipmentNote            String?
  deliveryReceivedBy      String?
  deliveryIdChecked       Boolean?
  deliveryNote            String?
  deliveryProofKey        String?
  deliveryProofFilename   String?
  deliveryProofMimeType   String?
  estimatedDelivery       DateTime?
  customerNote            String?
  internalNote            String?
  shippingMethodId        String?
  shippingMethodSnapshot  Json?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  couponRedemption        CouponRedemption?
  emailLogs               EmailLog[]
  loyaltyTransactions     LoyaltyTransaction[]
  customer                Customer             @relation(fields: [customerId], references: [id])
  shippingMethod          ShippingMethod?      @relation(fields: [shippingMethodId], references: [id])
  events                  OrderEvent[]
  items                   OrderItem[]
  payments                PaymentTransaction[]
  settlements             OrderPayment[]
  refunds                 OrderRefund[]
  rewardCouponsIssued    Coupon[]
  tickets                 Ticket[]
  convertedFromQuote      QuoteRequest?        @relation("QuoteConversion")
  complianceDocuments     OrderComplianceDocument[]

  @@index([customerId])
  @@index([paidAt])
  @@index([couponCode])
  @@index([shippingMethodId])
  @@index([status])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id                String        @id @default(cuid())
  orderId           String
  itemType          OrderItemType @default(PRODUCT)
  productSku        String?
  addonId           String?
  parentOrderItemId String?
  itemNameEn        String
  itemNameAr        String
  itemNameRu        String?
  itemImageSnapshot String?
  unitPrice         Decimal       @db.Decimal(10, 2)
  quantity          Int
  lineTotal         Decimal       @db.Decimal(10, 2)
  createdAt         DateTime      @default(now())
  addon             Addon?        @relation(fields: [addonId], references: [addonId], onDelete: Restrict)
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parentOrderItem   OrderItem?    @relation("OrderItemAddons", fields: [parentOrderItemId], references: [id])
  addonItems        OrderItem[]   @relation("OrderItemAddons")
  product           Product?      @relation(fields: [productSku], references: [sku], onDelete: Restrict)
  serials           OrderItemSerial[]

  @@index([orderId])
  @@index([productSku])
  @@index([addonId])
  @@index([itemType])
  @@index([parentOrderItemId])
}

model OrderItemSerial {
  id             String    @id @default(cuid())
  orderItemId    String
  unitIndex      Int
  value          String?
  overrideReason String?
  recordedById   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  recordedBy     Staff     @relation(fields: [recordedById], references: [id])

  @@unique([orderItemId, unitIndex])
  @@index([value])
  @@index([recordedById])
}

model OrderComplianceDocument {
  id             String                   @id @default(cuid())
  orderId        String
  source         ComplianceDocumentSource
  documentKind   String
  documentType   String?
  filename       String
  mimeType       String?
  declaredNumber String?
  sourceKey      String
  archiveKey     String?
  archivedAt     DateTime?
  createdAt      DateTime                 @default(now())
