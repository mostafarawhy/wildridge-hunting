{
  "name": "wildridge-hunting",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed/index.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --conditions=react-server prisma/seed/index.ts",
    "seed:catalog": "SEED_PHASE=1 tsx --conditions=react-server prisma/seed/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "content:capture": "tsx --conditions=react-server scripts/capture-content.ts",
    "content:optimize": "node scripts/optimize-content.mjs",
    "demo:reset": "tsx --conditions=react-server scripts/demo-reset.ts"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "countries-list": "^3.3.0",
    "framer-motion": "^12.38.0",
    "geist": "^1.8.2",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^1.11.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.9.1",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "resend": "^6.12.2",
    "server-only": "^0.0.1",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.39",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
