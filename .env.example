# Copy to .env and fill in. Prisma CLI loads .env (dotenv/config), so local values go in .env, not .env.local.
# Next.js also reads .env.local at runtime, but the Prisma CLI and seed scripts will not see it.
# Empty values are treated as unset.

# --- Database ---
# Pooled Postgres connection string used by the app. Required to boot.
DATABASE_URL=
# Direct Postgres connection string used by the Prisma CLI for migrations. Not needed to boot; required to run migrations.
DIRECT_URL=

# --- Supabase storage ---
# Supabase project URL, server side. Required to boot.
SUPABASE_URL=
# Supabase service role key, server only. Required to boot.
SUPABASE_SERVICE_ROLE_KEY=
# Same project URL exposed to the browser; builds public image URLs and the image host allow-list. Not needed to boot; images fall back to a placeholder without it.
NEXT_PUBLIC_SUPABASE_URL=
# Project ref of the demo Supabase project (20 lowercase letters or digits). Required by npm run demo:reset, which refuses to run unless every database and storage URL belongs to this ref.
DEMO_PROJECT_REF=
# Set to "true" to show placeholder images instead of storage URLs. Optional.
NEXT_PUBLIC_USE_PLACEHOLDER_IMAGES=

# --- Auth ---
# Secret used to sign sessions. Not validated at boot; sign-in fails without it.
AUTH_SECRET=

# --- App URL ---
# Public base URL with no trailing slash. Used for checkout return URLs and email links. Not needed to boot.
NEXT_PUBLIC_APP_URL=

# --- Staging gate ---
# Set to "true" to put the whole site behind Basic Auth. Default off.
STAGING_GATE_ENABLED=
# Basic Auth username. Only read when the gate is on; if missing then, every request gets a 401.
STAGING_USER=
# Basic Auth password. Only read when the gate is on; if missing then, every request gets a 401.
STAGING_PASS=

# --- Payments ---
# "mock" (default) or "ngenius". Optional.
PAYMENT_PROVIDER=
# N-Genius API key. Only used when PAYMENT_PROVIDER=ngenius. Optional.
NGENIUS_API_KEY=
# N-Genius outlet reference. Only used when PAYMENT_PROVIDER=ngenius. Optional.
NGENIUS_OUTLET_REF=
# N-Genius API base URL. Only used when PAYMENT_PROVIDER=ngenius. Optional.
NGENIUS_BASE_URL=

# --- Email (Resend) ---
# Resend API key. Optional; without it sends are skipped and logged as failed.
RESEND_API_KEY=
# Sender address. Optional; falls back to a hardcoded default in lib/services/resend.ts.
RESEND_FROM_EMAIL=
# Redirects all outgoing email to this address outside production. Optional.
EMAIL_REDIRECT_TO=

# --- Klaviyo ---
# Klaviyo private API key. Optional; newsletter sync is disabled without it.
KLAVIYO_PRIVATE_API_KEY=
# Klaviyo list ID to subscribe to. Optional; newsletter sync is disabled without it.
KLAVIYO_LIST_ID=

# --- Identity provider ---
# "manual" (default) or "uae_pass". Optional.
IDENTITY_PROVIDER=
# UAE PASS client ID. Only used when IDENTITY_PROVIDER=uae_pass. Optional.
UAE_PASS_CLIENT_ID=
# UAE PASS client secret. Only used when IDENTITY_PROVIDER=uae_pass. Optional.
UAE_PASS_CLIENT_SECRET=
# UAE PASS base URL. Only used when IDENTITY_PROVIDER=uae_pass. Optional.
UAE_PASS_BASE_URL=
# UAE PASS OAuth redirect URI. Only used when IDENTITY_PROVIDER=uae_pass. Optional.
UAE_PASS_REDIRECT_URI=
# Set to "true" to enable the UAE PASS callback route; otherwise it returns 501. Optional.
UAE_PASS_LIVE=
# Set to "true" to show UAE PASS sign-in, linking and verification. Anything else hides UAE PASS entirely. Optional.
NEXT_PUBLIC_UAE_PASS_ENABLED=

# --- Demo mode ---
# Set to "true" to turn on demo mode (banner, one-click access, restricted demo staff, customer document uploads blocked). Empty keeps normal behaviour.
NEXT_PUBLIC_DEMO_MODE=
# Password for the demo staff account that the "Enter as demo staff" button signs in. Required in demo mode and to seed staff.
DEMO_STAFF_PASSWORD=

# --- Seed ---
# Password for the super admin account. Required to seed staff.
SEED_ADMIN_PASSWORD=
# Run specific seed steps by number, comma separated (1 catalog, 5 featured, 6 staff, 7 settings, 8 shipping, 9 images, 10 demo data). Optional; empty runs all.
SEED_PHASE=
